[Unit]
Description=SNCF GTFS-RT bridge
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=yes
WorkingDirectory=/opt/sncf-gtfs-toolkit/scripts
ExecStart=/usr/bin/node bridge.mjs
Environment=PORT=80
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
